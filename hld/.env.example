# Copy this file to .env and fill in your key. .env is git-ignored; never commit a real key.
ANTHROPIC_API_KEY=

# Optional
# HLD_MODEL=claude-opus-5-5     # model Aria uses
# HLD_EFFORT=default            # default | none | low | medium | high  (none = send no effort setting, needed for older models)
# PORT=3000
# HLD_HOST=127.0.0.1            # keep the default unless you know what you are doing: the server spends your API key
# HLD_MOCK=1                    # offline demo mode with canned replies (no API calls)
